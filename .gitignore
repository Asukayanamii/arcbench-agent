# ---------------------------------------------------------------------------
# Preserved metadata of the upstream my_agent clone.
# The clone's .git was moved here so this repo can track my_agent/ as plain
# files. Kept on disk for reference; not part of this repository.
# To restore the clone:  move .my_agent_upstream_git back to my_agent/.git
# ---------------------------------------------------------------------------
.my_agent_upstream_git/

# Command Code's own workspace config (regenerated automatically)
.commandcode/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Build artifacts.
# The submission zip IS tracked on purpose: it is the artifact actually handed
# to the platform, so the exact submitted bytes must stay recoverable from
# history. Everything else in this section is reproducible from the tree.
# ---------------------------------------------------------------------------
*.zip
!my_agent-arcbench-submission.zip
dist/
build/
work/

# ---------------------------------------------------------------------------
# Scratch workspaces created by the local _test_*.py runs.
# These are throwaway; several of them are themselves git repos, so they must
# never enter the index as embedded repositories.
# ---------------------------------------------------------------------------
_stall_test/
_stream_test/
_arc_test_out/
_gittest/

# ---------------------------------------------------------------------------
# ARC runtime state and logs
# ---------------------------------------------------------------------------
.arc/
*.log

# 例外：归档到 run-logs/ 的运行日志是要入库的（给队友参考）。
# 上面的 *.log 是挡散落在项目根的那些临时日志，别把归档一起挡掉。
!run-logs/**/*.log

# Platform run logs, kept local only. They are large (3-4 MB each) and the
# findings drawn from them live in commit messages and HANDOVER.md instead.
new log.txt
new ticket log.txt

# ---------------------------------------------------------------------------
# Local secrets - .env.example stays tracked, a real .env never does
# ---------------------------------------------------------------------------
.env
.env.local
