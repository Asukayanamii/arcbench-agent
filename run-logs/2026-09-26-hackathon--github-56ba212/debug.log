[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "req_id": "REQ-1-1-1",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "type": "FUNC",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "name": "authRepository",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "file_path": "backend/src/repositories/authRepository.js",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "first_line": 1,
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "responsibility": "Account persistence gateway over the shared db_runtime helpers; the only module that issues SQL for the users table, including uniqueness lookups and inserts used by registration and the seeded account.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "specification": "Exports normalizeEmail(email) (trim + lowercase, the single canonical email form used by both storage and lookup), findAccountByUsername(username) -> row | null, findAccountByEmail(email) -> row | null, insertAccount({ username, email, passwordHash, emailVerified }) -> created row, and assertAccountFields(fields). All queries go through db_runtime run/get/all with parameter binding, so routes and services contain no SQL. Email uniqueness is enforced against the normalized form so 'Alice.Dev@Example.test' conflicts with the seeded 'alice.dev@example.test'. Username lookup relies on an exact-case column or a case-insensitive index so a duplicate username cannot slip through.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "inputs": "Normalized username/email, hashed password, verified flag.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "outputs": "Account rows (id, username, email, password_hash, email_verified) or null.",
