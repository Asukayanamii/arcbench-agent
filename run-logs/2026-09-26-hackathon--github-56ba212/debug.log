[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "interface_id": "REQ-1-1-1-DB-SEED-ACCOUNTS",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "req_id": "REQ-1-1-1",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "type": "DB",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "name": "seedDatabase auth accounts",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "file_path": "backend/src/database/seed_db.js",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "first_line": 1,
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "responsibility": "Deterministic idempotent bootstrap of the pre-existing account required by every scenario: username alice-dev, email alice.dev@example.test, password Valid-password-123!, email already verified, immediately usable for sign-in.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "specification": "Inside the existing seedDatabase() transaction, upsert the account row with INSERT OR IGNORE / INSERT OR REPLACE keyed on username so repeated runs and resets converge on the same state. Store the normalized email alice.dev@example.test, a hash of 'Valid-password-123!' produced by the same hashing path used by registration (never a hardcoded plaintext column), and email_verified = 1. The seeded account must be reachable through the normal repository/service/API path so sign-in works with either the username or the email, and it must be the natural product state created at application startup — not a test-only endpoint, frontend constant, or hidden fixture. This same seed entrypoint is what makes the duplicate-username and duplicate-email rejection cases testable against real data.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "inputs": "None (or optional dbPath/reset options from the harness).",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "outputs": "Idempotent insert of the alice-dev account; reseeding leaves exactly one row for that username.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "callers": [
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/database/index.js barrel",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/index.js/app startup path",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/database/test_harness.js",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/database/prepare_e2e.js"
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       ],
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "callees": [
