[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "interface_id": "REQ-1-1-1-API-AUTH-ROUTES",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "req_id": "REQ-1-1-1",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "type": "API",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "name": "authRoutes (/api/auth)",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "file_path": "backend/src/routes/authRoutes.js",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "first_line": 1,
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "responsibility": "HTTP boundary for the account-access capability: registration, session loading, sign-in, and sign-out, all returning field-scoped errors so the UI can render itemized messages. Mounted at /api/auth by backend/src/app.js (TDD wiring).",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "specification": "POST /api/auth/register body { username, email, password, confirmPassword, agreeToTerms } -> 201 { user: { id, username, email, emailVerified } } on success; 400 { errors: { username?|email?|password?|confirmPassword?|terms? } } on any rejection, with the canonical strings 'Username already exists', 'Username format is invalid', 'Email format is invalid', 'Password requirements are not satisfied', 'Agree to terms is required'. Multiple invalid fields must be reported in one response. GET /api/auth/session -> 200 { user: User | null } from the persisted session. POST /api/auth/login body { identifier, password } -> 200 { user } | 401 { errors }. POST /api/auth/logout -> 204 and clears the session. Handlers delegate to the service layer; they must not embed validation, hashing, or SQL. Error response body shape must stay stable so authApi.extractFieldErrors maps it.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "inputs": "JSON request bodies, the server-side session (req.session), service results.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "outputs": "JSON { user } / { errors } payloads with the documented status codes; the same HTTP boundary backs both the register and sign-in pages so errors stay consistent.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "callers": [
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "frontend/src/api/index.ts (axios apiClient baseURL '/api')",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "REQ-1-1-1-UI-REGISTRATION-PAGE",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "sign-in page",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "REQ-1-1-1-UI-AUTH-SESSION-PROVIDER",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/app.js mount at '/api/auth' (TDD wiring)"
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       ],
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "callees": [
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "REQ-1-1-1-FUNC-AUTH-SERVICE"
