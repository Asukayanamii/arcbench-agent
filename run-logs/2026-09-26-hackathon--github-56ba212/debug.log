[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "400 with all applicable field keys when several inputs are invalid",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "400 'Username already exists' for a duplicate username even with a fresh email, and no new row created",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "duplicate email rejected; no account row inserted on any rejection",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "GET /api/auth/session returns the registered user after registration and null when unauthenticated"
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       ]
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]     },
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]     {
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "interface_id": "REQ-1-1-1-FUNC-AUTH-SERVICE",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "req_id": "REQ-1-1-1",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "type": "FUNC",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "name": "authService",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "file_path": "backend/src/services/authService.js",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "first_line": 1,
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "responsibility": "Registration and session business logic: aggregate-all input validation, duplicate detection, password hashing, creation of a sign-in-capable and email-verified account, and session establishment.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "specification": "register(input, session) -> Promise<{ ok: true, user } | { ok: false, errors }>: normalize/trim username and email, validate username (1..39 lowercase ASCII letters, digits, single internal hyphens, no leading/trailing hyphen), email (trimmed, <=254, exactly one '@', at least one dot, non-empty domain labels), password (12..128 chars, upper + lower + digit + non-alphanumeric, no whitespace), confirmPassword equality, and agreeToTerms; collect and return ALL violations together rather than stopping at the first; check username and email uniqueness and return 'Username already exists' / 'Email already exists'; hash the password (never store plaintext, never log it); persist a sign-in-capable, already email-verified account; write the session userId so GET /api/auth/session can restore state. getUserById(id) -> User | null for session loading. findingSessionUser(credentials, session) -> { ok, user } | { ok: false, errors } for the shared sign-in path, matching the same { ok, errors } shape. AUTH_ERROR_MESSAGES centralizes the canonical strings shared with the client. No SQL in this module.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "inputs": "Raw request body fields, server session object, repository results.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "outputs": "{ ok, user } or { ok, errors } results plus session mutation; user shape { id, username, email, emailVerified }.",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "callers": [
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "REQ-1-1-1-API-AUTH-ROUTES"
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       ],
