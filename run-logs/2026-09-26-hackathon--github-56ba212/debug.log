[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       "test_focus": [
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "lookups return the seeded and newly registered accounts",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "insertAccount never stores plaintext passwords",
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]         "duplicate insert attempts are rejected by the schema constraint and surfaced to the service"
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]       ]
[2026-09-26T16:02:28.037+08:00] [InterfaceDesigner][REQ-1-1-1]     },
