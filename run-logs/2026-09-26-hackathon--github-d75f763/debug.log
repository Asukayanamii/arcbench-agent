[2026-09-26T18:17:16.156+08:00] [TestDrivenDeveloper][REQ-1-1-1] tool-call> write_file args={"content": "import { useCallback, useEffect, useState } from 'react';\n\n/**\n * Minimal client-side router.\n *\n * The app is small and route-driven, so a dependency-free router keeps the\n * registration -> sign-in -> home chain navigable without full reloads while\n * still rendering plain `href` anchors (deep links such as `/signup` keep\n * working through the backend SPA fallback).\n */\n\nconst NAVIGATION_EVENT = 'app:navigate';\n\nexport function currentPath(): string {\n  if (typeof window === 'undefined') {\n    return '/';\n  }\n  return window.location.pathname || '/';\n}\n\n/** Push a new history entry and notify the router listeners. */\nexport function navigate(path: string): void {\n  if (typeof window === 'undefined') {\n    return;\n  }\n  if (window.location.pathname === path) {\n    window.dispatchEvent(new Event(NAVIGATION_EVENT));\n    return;\n  }\n  window.history.pushState({}, '', path);\n  window.dispatchEvent(new Event(NAVIGATION_EVENT));\
