[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "file_path": "backend/src/services/session_context.js",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "first_line": 1,
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "responsibility": "Single backend boundary that answers 'who is the current user for this request?' so protected organization/repository/work-item routes derive the current user from the login session instead of trusting request input.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "specification": "Exports SESSION_COOKIE_NAME ('session_token'), readSessionToken(req) (parses the raw Cookie header), resolveCurrentAccount(req) -> Promise<public account|null> delegating to authService.getSessionAccount (no duplication of session validation), and requireSession(req,res,next) which attaches req.currentAccount and responds 401 { error: 'Authentication required' } when no valid session exists, failing closed on missing/invalid/expired/inactive sessions. Protected feature routers must mount requireSession (or call resolveCurrentAccount) rather than re-implementing cookie or session parsing.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "inputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "Express request with Cookie header"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "outputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "public account for the request, or null",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "401 { error: 'Authentication required' } from requireSession",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "req.currentAccount attachment"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
