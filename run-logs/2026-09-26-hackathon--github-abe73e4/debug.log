[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]     {
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "interface_id": "REQ-1-1-2-API-AUTH-CLIENT",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "req_id": "REQ-1-1-2",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "type": "API",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "name": "authApi (sign-in, session restore, sign-out client)",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "file_path": "frontend/src/api/authApi.ts",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "first_line": 1,
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "responsibility": "Frontend HTTP boundary for account access: submits credentials, restores the durable session, and revokes it; normalizes failures into the generic sign-in result the page renders.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "specification": "Uses the shared axios instance from ./index (baseURL '/api', withCredentials true, global error interceptor). `signIn({identifier, password}): Promise<{ok, account?, error?}>` POSTs /auth/login and returns the account on 200; on any error it returns { ok: false, error } where the message falls back to the generic 'Invalid credentials' (the API's 401 body is `{ error }` and the interceptor copies it onto error.message). `fetchSession(): Promise<AuthAccount|null>` GETs /auth/session and returns `data.account ?? null`. `logout()` POSTs /auth/logout. AuthAccount = { id, username, email, emailVerified }.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "inputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "SignInInput { identifier: string; password: string }",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "session cookie managed by the browser (withCredentials)"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "outputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "SignInResult { ok: boolean; account?: AuthAccount; error?: string }",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "AuthAccount | null from fetchSession",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "void from logout"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "callers": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "REQ-1-1-2-UI-SIGNIN-FORM",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "REQ-1-1-2-UI-SESSION-PROVIDER (fetchSession, logout)"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "callees": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "REQ-1-1-2-API-AUTH-ROUTES (/api/auth/login, /api/auth/session, /api/auth/logout)",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "frontend/src/api/index.ts interceptors"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "test_focus": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "Successful sign-in resolves ok with the account payload",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "401 response resolves ok:false with the generic message and no account",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "fetchSession resolves null for an anonymous browser"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ]
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]     },
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]     {
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "interface_id": "REQ-1-1-2-API-AUTH-ROUTES",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "req_id": "REQ-1-1-2",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "type": "API",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "name": "Auth HTTP routes (login, session, logout)",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "file_path": "backend/src/routes/auth_routes.js",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "first_line": 1,
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "responsibility": "Thin HTTP boundary mounted at /api/auth: shapes sign-in/session/logout requests and responses and owns the session cookie transport.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "specification": "POST /api/auth/login -> 200 { account } with Set-Cookie `session_token=<token>; Path=/; HttpOnly; SameSite=Lax; Max-Age=<SESSION_MAX_AGE_SECONDS>` on success, or 401 { error: 'Invalid credentials' } for unknown identifier, wrong password, or unavailable account (identical body for all three). GET /api/auth/session -> 200 { account: Account|null } resolved from the cookie token via the service (refresh-safe restore). POST /api/auth/logout -> 200 { ok: true } and clears the cookie. Never returns password material or a differentiated failure reason. When protected domain routes need the request's current account they must use the shared resolver instead of re-parsing cookies; keep the cookie name sourced from the shared session-context constant so client, route, and service stay consistent.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "inputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "JSON body { identifier, password } for login",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "Cookie header containing session_token"
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       ],
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "outputs": [
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]         "200 { account } + session cookie",
