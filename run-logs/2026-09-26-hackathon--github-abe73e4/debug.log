[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "name": "authService.signIn / getSessionAccount / signOut",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "file_path": "backend/src/services/auth_service.js",
