[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "req_id": "REQ-1-1-2",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "type": "DB",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "name": "Deterministic pre-existing account seed (alice-dev)",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "file_path": "backend/src/database/seed_db.js",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "first_line": 1,
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "responsibility": "Provides the GIVEN pre-existing, verified, available account as ordinary product data reachable through the normal startup path, not as a test-only fixture.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "specification": "seedDatabase() runs `INSERT OR IGNORE` for the deterministic account { username: 'alice-dev', email: 'alice.dev@example.test', password: 'Valid-password-123!' } with a fixed salt and `email_verified = 1`, inside a transaction, so repeated runs (app start, test DB setup, E2E preparation) change nothing. It is invoked by backend/src/index.js after initializeDatabase() so the account exists for a fresh runtime database and is sign-in capable through the real UI -> API -> service -> DB path. Seed data stays limited to genuine product preconditions; no scenario-time credentials or evaluator-specific fixtures may be added.",
[2026-09-26T17:24:51.278+08:00] [InterfaceDesigner][REQ-1-1-2]       "inputs": [
