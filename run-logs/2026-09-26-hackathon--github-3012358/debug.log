[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "file_path": "backend/src/routes/auth_routes.js",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "first_line": 1,
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "responsibility": "Expose the auth HTTP contract: registration with itemized field errors, credential sign-in, cookie-based session lookup and sign-out.",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "specification": "Express router mounted by backend/src/app.js at '/api/auth' (mount edit pending). POST /register with { username, email, password, confirmPassword, agreeToTerms } -> 201 { user: { id, username, email, emailVerified: true } } and starts the httpOnly session cookie for the sign-in-capable account; on any rejection -> 400 { errors: { username?, email?, password?, confirmPassword?, terms? } } where each key may carry its message and multiple keys are returned together (no short-circuiting); no account is created. POST /sign-in with { email, password } -> 200 { user } + session cookie, or 401 { errors: { form } }. GET /session -> 200 { user: SessionUser | null } resolved from the session cookie (used for refresh recovery). POST /sign-out -> 200 { ok: true } and clears the session. JSON never echoes the password or password hash.",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "inputs": "HTTP JSON request bodies; session cookie header.",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "outputs": "JSON responses with the documented status codes and session cookie side effects.",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "callers": [
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]         "frontend/src/features/auth/authApi.ts",
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]         "backend/src/app.js (route mounting)"
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       ],
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       "callees": [
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]         "REQ-1-1-1-FUNC-AUTH-SERVICE"
[2026-09-26T16:09:50.483+08:00] [InterfaceDesigner][REQ-1-1-1]       ],
